rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The admin is identified EXCLUSIVELY through the custom claim in the token
    // (NFR-SEC-09), same convention as firestore.rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Reads the monthlyReports doc ONCE (via `let`) and checks BOTH fields
    // against that single fetch — unlike the tenancies/contract rule below
    // (which only ever checks one field, so a bare inline firestore.get() is
    // enough there), this path needs userId AND status from the SAME
    // document, so a helper avoids two separate firestore.get() calls for
    // one read request.
    function isOwningTenantOfSignedReport(reportId) {
      let report = firestore.get(/databases/(default)/documents/monthlyReports/$(reportId)).data;
      return report.userId == request.auth.uid && report.status == 'signed';
    }

    // /drafts/{draftId}/* — admin only (SRS §6). Onboarding ID photos (tenant +
    // guarantor) are uploaded here as they are captured (Sub-stage D); the folder
    // is flat, the tenant-vs-guarantor distinction lives in the Firestore draft's
    // arrays, not in the Storage path.
    match /drafts/{draftId}/{fileName} {
      allow read, write: if isAdmin();
    }

    // /users/{userId}/documents/* and /users/{userId}/guarantor/* — admin only
    // (SRS §6, M3-B). Backs the Profile tab's ID-photo re-upload/delete for a
    // FINALIZED tenant. A finalized tenant's ID photos physically live here:
    // finalizeKyc migrates them from /drafts/{draftId}/ on finalization (copy-
    // first, delete-after-commit — CLAUDE.md §7), so /drafts/ never holds a
    // finalized tenant's photos afterward. A Profile-tab re-upload also lands
    // under these paths, writing/replacing the same array entries.
    match /users/{userId}/documents/{fileName} {
      allow read, write: if isAdmin();
    }
    match /users/{userId}/guarantor/{fileName} {
      allow read, write: if isAdmin();
    }

    // /tenancies/{tenancyId}/contract/* — admin write; the tenant that tenancy
    // belongs to may also READ (FR-CON-07: the signed contract is
    // visible/downloadable by the tenant). Mirrors firestore.rules' tenancies
    // rule (`resource.data.userId == request.auth.uid`), but Storage Rules
    // have no Firestore `resource` to read from directly — `firestore.get()`
    // (Storage Rules v2 cross-service read) fetches the tenancy document so
    // the same ownership check can be made here.
    match /tenancies/{tenancyId}/contract/{fileName} {
      allow read: if isAdmin() ||
        (request.auth != null &&
          firestore.get(/databases/(default)/documents/tenancies/$(tenancyId)).data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // /reports/{reportId}/invoices/* — admin write; the tenant that report
    // belongs to may READ, ONLY once it is signed (FR-DOC-01…05, mirrors the
    // tenancies/contract rule's firestore.get() pattern, SRS §6). An unsigned
    // report's attachments stay invisible to the tenant — same visibility
    // boundary as the report document itself (FR-REP-06/08).
    match /reports/{reportId}/invoices/{fileName} {
      allow read: if isAdmin() ||
        (request.auth != null && isOwningTenantOfSignedReport(reportId));
      allow write: if isAdmin();
    }

    // Per-path rules are added as the milestones progress, per SRS §6.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
