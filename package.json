{
  "name": "tenants-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The monorepo root: hosts the code quality tooling, shared by web/ and functions/.",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "npm run dev --prefix web",
    "emulators": "firebase emulators:start",
    "dev:all": "concurrently -n web,emu -c cyan,magenta \"npm run dev\" \"npm run emulators\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage,functions --project tenants-manager-2026 \"npx playwright test\""
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  }
}
