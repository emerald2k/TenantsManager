# Configuration template for the Cloud Functions — IT IS COMMITTED to git.
# Copy it to `functions/.env` (which is in .gitignore) and fill in the values:
#
#   cp functions/.env.example functions/.env
#
# Cloud Functions v2 loads `functions/.env` automatically at deploy and when
# run through the Functions emulator. Every variable here has a safe fallback
# in code, so LOCAL emulator development works even without a `functions/.env`
# — the file matters for a real `firebase deploy`.
#
# Do NOT put a service-account key here. The functions run with the Admin SDK
# under the project's own service identity; they never read a key file.

# The Storage bucket the functions read from and write to. MUST be
# hand-identical to web/.env's VITE_FIREBASE_STORAGE_BUCKET and to the
# STORAGE_BUCKET constant in kyc.js / sharedReport.js / deleteOnboardingDraft.js
# — getStorage().bucket() with no argument resolves a context-dependent
# default and must never be relied on (CLAUDE.md §7).
STORAGE_BUCKET=tenants-manager-2026.firebasestorage.app

# The address every admin-facing notification email is sent to (FR-SYS-07,
# checkAdminEmailConfigured). Leave BLANK to make the app surface the
# "email not configured" banner instead of sending nowhere.
ADMIN_EMAIL=

# The origin used to build links in outgoing emails (report URLs, the shared
# `/r/:token` link, credentials). Falls back to http://localhost:5173 in code.
APP_URL=http://localhost:5173
