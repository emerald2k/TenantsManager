rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The admin is identified EXCLUSIVELY through the custom claim in the token
    // (NFR-SEC-09). The token is already validated by Firebase by the time it
    // reaches here — we only read it.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // properties — admin-only access (SRS §7.3, NFR-SEC-02).
    //
    // The rule is an ACCESS boundary, not a business-logic one: it does NOT
    // filter archived properties here. `archived == false` is a display
    // preference and is applied in the query/hook (useProperties), where it can
    // also be turned off for the "Show archived" toggle (FR-PROP-07). A rule
    // filtering by `archived` would make the soft-delete (FR-PROP-06) look like
    // a real deletion and would block the admin from seeing their own archived data.
    match /properties/{propertyId} {
      allow read, write: if isAdmin();
    }

    // onboardingDrafts — admin-only access (SRS §6, NFR-SEC-02).
    //
    // The draft holds partial KYC data (the step 1-4 fields) before an account
    // exists; it is strictly admin-only, exactly like `users`. The tenant never
    // touches a draft — no account is created until KYC completion (FR-TEN-16,
    // FR-TEN-17). Deleted automatically on completion (FR-TEN-18) or manually
    // (FR-TEN-20); both are admin writes covered by this same rule.
    match /onboardingDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // users — admin-only access (SRS §7.3, NFR-SEC-02): "admin = custom claim
    // admin==true → full access everywhere". The tenant never reads/writes this
    // collection directly — they only see denormalized data in `tenancies` and
    // their own published `monthlyReports` (CLAUDE.md §7). Needed now (Sub-stage C)
    // for the Step 1 live email/CNP checks (FR-TEN-07, FR-TEN-22), which read
    // `users` from the browser as the admin; previously only the Cloud Function
    // (Admin SDK, bypasses rules) had ever touched this collection.
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // tenancies — admin full access; the tenant reads ONLY their own tenancy
    // (SRS §6: "admin full; the tenant reads where userId == auth.uid"). First
    // client access to this collection (Sub-stage E) — until now only finalizeKyc
    // (Admin SDK, bypasses rules) ever wrote it. Writes stay admin-only: the
    // tenant portal (M3) never mutates a tenancy, only reads it.
    match /tenancies/{tenancyId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // monthlyReports — admin full access; the tenant reads ONLY their own
    // SIGNED report (SRS §6/§7.3: "admin full; the tenant reads where userId
    // == auth.uid and status == 'signed'"). A draft is invisible to the
    // tenant by design (FR-REP-06/08) — this is the exact enforcement point.
    // Public (no-auth) access via shareToken does NOT go through this rule —
    // it is served by the getSharedReport Cloud Function (sub-stage 8), which
    // is why there is no "shareToken" branch here.
    //
    // `status` is pinned on update (NFR-SEC-11, M8): an admin client write
    // is allowed only when it leaves `status` unchanged. §6 has always said
    // the draft<->signed transition happens EXCLUSIVELY through the
    // signReport/unlockReport callables (§7.2), never a direct client write —
    // until now nothing enforced that, it was upheld by client discipline
    // alone. Both callables run on the Admin SDK, which bypasses Security
    // Rules entirely, so the pin costs the admin client nothing it is
    // supposed to be able to do; it just makes the written invariant true by
    // construction.
    match /monthlyReports/{reportId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'signed');
      allow create: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.status == resource.data.status;
      allow delete: if isAdmin();
    }

    // mail — Cloud Functions only. NO client access, admin included (SRS §6,
    // NFR-SEC-02). `message.text` holds the fully rendered body, and Appendix
    // A1 interpolates the generated password IN CLEAR TEXT. Nothing ever
    // deletes a mail document, so granting even admin reads would make every
    // password ever generated permanently readable from a browser session.
    // The administrator's view of sent mail is the projected `notifications`
    // collection below — subject line only, never a body (FR-NLOG-02).
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // notifications — admin-read, server-write (NFR-SEC-10, FR-NLOG-01…08).
    // There is NO `allow write` clause of any kind here — not for the admin,
    // not for anyone. "Cloud Functions write only" names a principal that
    // does not exist: the Admin SDK (onMailWrite, §7.2) bypasses Security
    // Rules entirely, so the ABSENCE of a write rule IS the server-write
    // guarantee. Writing it positively (`if isAdmin()`) would instead open a
    // client write path the requirement explicitly forbids.
    match /notifications/{notificationId} {
      allow read: if isAdmin();
    }

    // The remaining collections are not implemented yet.
    // Per-collection rules are added as the milestones progress, per SRS §7.3.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
